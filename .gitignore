# ==============================================================================
# ShopSync — Git Ignore Specification (.gitignore)
# ==============================================================================

# Dependencies
node_modules/
/.pnp
.pnp.js

# Testing & Coverage
coverage/
*.lcov
.nyc_output

# Next.js Build Artifacts
/.next/
/out/
/build/
dist/

# TypeScript Build Info
*.tsbuildinfo
next-env.d.ts

# Production & Local Environment Secret Files
.env
.env.*
.env*.local
.env.staging
.env.production
.env.test

# Explicit Exception: Always commit placeholder template
!.env.example

# Local Databases, Dumps, and Snapshots
/data/
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3
*.backup*.json
/data/backups/
/data/staging/

# Vercel Deployment Artifacts
.vercel

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE and Editor Directories
.idea/
.vscode/
*.swp
*.swo
*~
