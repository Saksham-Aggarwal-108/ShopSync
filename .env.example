# ==============================================================================
# ShopSync — Phase 6: Environment Configuration Specification (.env.example)
# Architecture: Vercel (Frontend) + Render (Node.js API) + Supabase (PostgreSQL)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Persistence (Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Obtain your connection string from the Supabase Project Dashboard:
# Project Settings -> Database -> Connection String -> URI (or Connection Pooling URI)
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres?pgbouncer=true
# Or direct: postgresql://postgres:[db-password]@db.[project-ref].supabase.co:5432/postgres
# NEVER expose this variable to the Vercel frontend or client-side code!
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# Connection pool settings for Render Web Service:
DATABASE_SSL="true"
DB_POOL_MAX=10

# Offline in-memory database emulation (STRICTLY PROHIBITED in production mode):
# Set to "true" ONLY for offline automated testing when no PostgreSQL instance is available.
# In production, this flag is rejected and startup will abort if DATABASE_URL is missing.
ALLOW_MEMORY_DB="false"

# ------------------------------------------------------------------------------
# 2. Render Backend Web Service Configuration
# ------------------------------------------------------------------------------
PORT=10000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 3. Authentication & Cryptographic Security
# ------------------------------------------------------------------------------
ADMIN_EMAIL=admin@greenwood.local
# In production, replace ADMIN_PASSWORD with a strong, non-default passphrase:
ADMIN_PASSWORD=change_this_to_a_strong_random_password_in_production
# Cryptographic HMAC-SHA256 session token secret (>= 32 chars):
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace_with_a_cryptographically_secure_random_string_in_production
# Strict secret validator (rejects default passwords in production):
STRICT_PRODUCTION_SECRETS=true

# ------------------------------------------------------------------------------
# 4. Cross-Origin Architecture & CORS (Render <-> Vercel)
# ------------------------------------------------------------------------------
# Configure FRONTEND_URL on Render to allow credentialed CORS requests from Vercel:
FRONTEND_URL="https://shopsync.vercel.app"

# Comma-separated list of additional allowed frontend origins (e.g., Vercel previews):
ALLOWED_ORIGINS="https://shopsync-preview.vercel.app,http://localhost:3000"

# Set to "true" only if client browsers make direct cross-origin requests to Render
# without using the Vercel proxy rewrite. When false, SameSite=Lax is used.
CROSS_ORIGIN_COOKIES=false

# ------------------------------------------------------------------------------
# 5. Vercel Frontend Configuration (Set in Vercel Project Environment)
# ------------------------------------------------------------------------------
# On Vercel, requests to /api/* are seamlessly rewritten to the Render backend URL:
BACKEND_API_URL="https://shopsync-api.onrender.com"

# Optional client-side API base URL (leave empty when using Vercel proxy rewrite):
NEXT_PUBLIC_API_URL=""

# ------------------------------------------------------------------------------
# 6. Email Notifications & Notification Outbox (Simulated by Default)
# ------------------------------------------------------------------------------
# Leave SMTP_HOST empty to operate in SIMULATED mode (safe for testing & staging).
# Outbox logs are tracked in the PostgreSQL notification_logs table.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Greenwood Provisions <orders@greenwoodprovisions.local>"
SMTP_SECURE=false
